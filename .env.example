# Optional alternate MapLibre style URL for deployments with a private tile provider.
VITE_CARTOGRAPHIC_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional satellite raster tile template. Keep attribution and provider terms visible.
VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_SATELLITE_ATTRIBUTION=Tiles © Esri — Source: Esri, Maxar, Earthstar Geographics and the GIS User Community
# Optional key-free geocoding endpoint. Keep private API keys on a server-side proxy.
VITE_GEOCODING_ENDPOINT=https://nominatim.openstreetmap.org
# Optional public or server-proxied currency rate endpoint.
VITE_CURRENCY_RATE_ENDPOINT=https://api.frankfurter.app/latest
