{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://world-map.local/schemas/note.schema.json",
    "title": "Sticky Note tag",
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "type", "name", "content", "country", "city", "coordinates", "sources", "locked", "createdAt", "updatedAt"],
    "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "type": { "const": "note" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "country": { "type": "string", "minLength": 1, "maxLength": 120 },
        "countryCode": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "city": { "type": "string", "minLength": 1, "maxLength": 120 },
        "coordinates": {
            "type": "object",
            "additionalProperties": false,
            "required": ["longitude", "latitude"],
            "properties": {
                "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
                "latitude": { "type": "number", "minimum": -90, "maximum": 90 }
            }
        },
        "sources": {
            "type": "array",
            "maxItems": 1000,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "url"],
                "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
                    "url": { "type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://" },
                    "accessedAt": { "type": "string", "format": "date-time" }
                }
            }
        },
        "locked": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
    }
}
